# Anthropic API Key for N.I.K.K.I. chat (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key for Whisper (transcription)
OPENAI_API_KEY=sk-your-key-here

# ElevenLabs for Nikki's text-to-speech voice (server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional: voice id to use. Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a warm
# voice good for young children. Find/copy voice ids in the ElevenLabs dashboard
# under Voices (or the Voice Library) — open a voice and copy its Voice ID.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase (client-side auth) — exposed to the browser via Vite's VITE_ prefix
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service client for Stripe webhooks (server-side only).
# Use the new sb_secret_ format key, applied the same way as a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret

# Stripe — server-side keys only (card entry happens on Stripe's pages)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ELEMENTARY_MONTHLY=price_xxx
STRIPE_PRICE_ELEMENTARY_ANNUAL=price_xxx
STRIPE_PRICE_MIDDLE_MONTHLY=price_xxx
STRIPE_PRICE_MIDDLE_ANNUAL=price_xxx
STRIPE_PRICE_HIGH_MONTHLY=price_xxx
STRIPE_PRICE_HIGH_ANNUAL=price_xxx
STRIPE_PRICE_ADDON_KID_MONTHLY=price_xxx
STRIPE_PRICE_ADDON_KID_ANNUAL=price_xxx

# Stripe publishable key (client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# School-license bridge to the Dean project (SERVER-ONLY — never VITE_-prefixed).
# The shared secret must never reach the browser; it is used only by api/school-*.
TUTORING_BRIDGE_SECRET=your-dean-bridge-secret
# Dean Edge Functions base URL (optional override; defaults to the deployed one).
DEAN_FUNCTIONS_URL=https://ckgyctshyrjcxlxzkabe.supabase.co/functions/v1
# Maps a verified SSO email domain -> Dean school_id (JSON). SERVER-ONLY. The
# client never supplies school_id; api/school-login derives it from this map.
SCHOOL_DOMAIN_MAP={"tutortest.org":"03e7f740-a2b4-4cbe-bd90-f39b61797f25"}
# SERVER-ONLY. This project's JWT secret (Supabase Dashboard > Settings > API >
# JWT Secret). Used ONLY to hand-sign short-lived sessions for minted K-8 covered
# identities. Never expose to the client.
SUPABASE_JWT_SECRET=your-project-jwt-secret

# Dean project staff SSO for the K-8 station (client — anon key is public-safe).
VITE_DEAN_SUPABASE_URL=https://ckgyctshyrjcxlxzkabe.supabase.co
VITE_DEAN_SUPABASE_ANON_KEY=your-dean-anon-key
