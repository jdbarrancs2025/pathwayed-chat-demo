# Anthropic API Key for N.I.K.K.I. chat (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key for Whisper (transcription)
OPENAI_API_KEY=sk-your-key-here

# ElevenLabs for Nikki's text-to-speech voice (server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional: voice id to use. Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a warm
# voice good for young children. Find/copy voice ids in the ElevenLabs dashboard
# under Voices (or the Voice Library) — open a voice and copy its Voice ID.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase (client-side auth) — exposed to the browser via Vite's VITE_ prefix
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service client for Stripe webhooks (server-side only).
# Use the new sb_secret_ format key, applied the same way as a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret

# Stripe — server-side keys only (card entry happens on Stripe's pages)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ELEMENTARY_MONTHLY=price_xxx
STRIPE_PRICE_ELEMENTARY_ANNUAL=price_xxx
STRIPE_PRICE_MIDDLE_MONTHLY=price_xxx
STRIPE_PRICE_MIDDLE_ANNUAL=price_xxx
STRIPE_PRICE_HIGH_MONTHLY=price_xxx
STRIPE_PRICE_HIGH_ANNUAL=price_xxx
STRIPE_PRICE_ADDON_KID_MONTHLY=price_xxx
STRIPE_PRICE_ADDON_KID_ANNUAL=price_xxx

# Stripe publishable key (client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
